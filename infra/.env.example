# rental-crm 인프라 환경변수 템플릿
#
# 사용법:
#   1. 본 파일을 .env 로 복사 (cp .env.example .env)
#   2. 필요한 값 수정
#   3. .env 는 .gitignore 처리되어 커밋 안 됨

# ============================================================
# Oracle Database
# ============================================================
# SYS / SYSTEM 계정 비밀번호
ORACLE_PASSWORD=oracle

# ⚠️ ORACLE_DATABASE 변수는 설정하지 않음.
# gvenzl/oracle-xe 의 기본 PDB(XEPDB1) 가 이미 존재하므로 환경변수로 명시하면
# 새 PDB 생성 시도 → ORA-65012 (이미 존재) 발생 → 이후 APP_USER 생성 절차 중단됨.
# Spring Boot 의 JDBC URL 에서 //localhost:1521/XEPDB1 로 접속.

# 애플리케이션 계정 (Spring Boot 가 사용할 사용자)
ORACLE_APP_USER=rental
ORACLE_APP_PASSWORD=rental

# 호스트 포트 (다른 Oracle 인스턴스와 충돌 시 변경)
ORACLE_PORT=1521

# ============================================================
# Kafka
# ============================================================
KAFKA_PORT=9092
KAFKA_UI_PORT=8090

# ============================================================
# Redis
# ============================================================
REDIS_PORT=6379
